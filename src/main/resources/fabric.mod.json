{
  "schemaVersion": 1,
  "id": "liquidbounce-extras",
  "version": "${version}",
  "name": "LiquidBounce Extras",
  "description": "Modules the client does not ship, and the reference for the add-on API.",
  "authors": [
    "CCBlueX"
  ],
  "contact": {
    "homepage": "https://liquidbounce.net/",
    "sources": "https://github.com/CCBlueX/LiquidBounce-Addon-Extras",
    "issues": "https://github.com/CCBlueX/LiquidBounce-Addon-Extras/issues"
  },
  "license": "GPL-3.0-or-later",
  "icon": "resources/liquidbounce-extras/icon.png",
  "environment": "client",
  "entrypoints": {
    "liquidbounce": [
      "net.ccbluex.liquidbounce.extras.ExtrasAddon"
    ]
  },
  "accessWidener": "liquidbounce-extras.accesswidener",
  "depends": {
    "minecraft": "~${minecraft_version}",
    "fabricloader": ">=${loader_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}",
    "liquidbounce": "*"
  },
  "custom": {
    "liquidbounce": {
      "color": "#FF5555"
    },
    "modmenu": {
      "parent": "liquidbounce"
    }
  }
}
