{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent usage of one change",
  "type": "object",
  "additionalProperties": false,
  "required": ["date", "change", "tool", "models"],
  "properties": {
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "change": { "type": "string", "minLength": 1, "description": "Subject of the change, as in its commit" },
    "tool": { "type": "string", "minLength": 1, "description": "omp, claude-code, or the tool used" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["model", "provider", "tokens", "usd"],
        "properties": {
          "model": { "type": "string", "minLength": 1, "description": "Model id without provider prefix, as in @agent tags" },
          "provider": { "type": "string", "minLength": 1 },
          "tokens": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "cachedInput", "cacheWrite", "output"],
            "properties": {
              "input": { "type": "integer", "minimum": 0 },
              "cachedInput": { "type": "integer", "minimum": 0 },
              "cacheWrite": { "type": "integer", "minimum": 0 },
              "output": { "type": "integer", "minimum": 0 }
            }
          },
          "usd": { "type": "number", "minimum": 0, "description": "Cost at the provider's list price" }
        }
      }
    }
  }
}
